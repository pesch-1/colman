# colman_docs.cmake — documentation targets (doc, tutorial, tutorial_<lang>).
#
# Included from the top-level CMakeLists.txt, either as part of the full
# build or alone when COLMAN_DOCS_ONLY is set (no Qt or other build
# dependencies needed, e.g. for publishing the tutorial on GitHub Pages).
find_package(Doxygen)
find_program(MAKE_PROGRAM NAMES make gmake)
if(DOXYGEN_FOUND)
  configure_file(
    "${CMAKE_CURRENT_SOURCE_DIR}/doc/Doxyfile.in"
    "${CMAKE_CURRENT_BINARY_DIR}/Doxyfile"
    @ONLY
  )
  add_custom_target(doc
    COMMAND ${DOXYGEN_EXECUTABLE} "${CMAKE_CURRENT_BINARY_DIR}/Doxyfile"
    WORKING_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}"
    COMMENT "Generating documentation (HTML)"
    VERBATIM
  )
  # One tutorial per language directory doc/tutorial/<lang>/ that contains a
  # colman_tutorial.dox; screenshots live in doc/tutorial/<lang>/screenshots
  # (generated by tutorial_screenshots_<lang>).
  set(COLMAN_TUTORIAL_LANGS de en)
  set(TUTORIAL_PROJECT_NAME_de "Colman Schritt-für-Schritt-Anleitung")
  set(TUTORIAL_OUTPUT_LANGUAGE_de German)
  set(TUTORIAL_TIP_de Tipp)
  set(TUTORIAL_HINT_de Hinweis)
  set(TUTORIAL_WARNING_de Warnung)
  set(TUTORIAL_PROJECT_NAME_en "Colman Step-by-Step Guide")
  set(TUTORIAL_OUTPUT_LANGUAGE_en English)
  set(TUTORIAL_TIP_en Tip)
  set(TUTORIAL_HINT_en Note)
  set(TUTORIAL_WARNING_en Warning)
  set(tutorial_targets)
  foreach(TUTORIAL_LANG IN LISTS COLMAN_TUTORIAL_LANGS)
    if(NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/doc/tutorial/${TUTORIAL_LANG}/colman_tutorial.dox")
      continue()
    endif()
    list(APPEND tutorial_targets tutorial_${TUTORIAL_LANG})
    set(TUTORIAL_PROJECT_NAME "${TUTORIAL_PROJECT_NAME_${TUTORIAL_LANG}}")
    set(TUTORIAL_OUTPUT_LANGUAGE "${TUTORIAL_OUTPUT_LANGUAGE_${TUTORIAL_LANG}}")
    set(TUTORIAL_TIP "${TUTORIAL_TIP_${TUTORIAL_LANG}}")
    set(TUTORIAL_HINT "${TUTORIAL_HINT_${TUTORIAL_LANG}}")
    set(TUTORIAL_WARNING "${TUTORIAL_WARNING_${TUTORIAL_LANG}}")
    set(tutorial_out "${CMAKE_CURRENT_BINARY_DIR}/tutorial/${TUTORIAL_LANG}")
    configure_file(
      "${CMAKE_CURRENT_SOURCE_DIR}/doc/Doxyfile_tutorial.in"
      "${CMAKE_CURRENT_BINARY_DIR}/Doxyfile_tutorial_${TUTORIAL_LANG}"
      @ONLY
    )
    add_custom_target(tutorial_${TUTORIAL_LANG}
      COMMAND ${CMAKE_COMMAND} -E make_directory "${tutorial_out}"
      COMMAND ${DOXYGEN_EXECUTABLE}
        "${CMAKE_CURRENT_BINARY_DIR}/Doxyfile_tutorial_${TUTORIAL_LANG}"
      COMMAND ${CMAKE_COMMAND}
        -D "REFMAN_TEX=${tutorial_out}/latex/refman.tex"
        -D "LOGO_SRC=${CMAKE_CURRENT_SOURCE_DIR}/flutter/assets/icons/colman_logo.jpeg"
        -D "LOGO_DST=${tutorial_out}/latex/colman_logo.jpeg"
        -P "${CMAKE_CURRENT_SOURCE_DIR}/doc/patch_tutorial_title.cmake"
      COMMAND ${MAKE_PROGRAM} -C "${tutorial_out}/latex"
      COMMAND ${CMAKE_COMMAND} -E rename
        "${tutorial_out}/latex/refman.pdf"
        "${tutorial_out}/latex/colman_tutorial.pdf"
      WORKING_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}"
      COMMENT "Generating ${TUTORIAL_LANG} tutorial (HTML + PDF)"
      VERBATIM
    )
  endforeach()
  if(tutorial_targets)
    add_custom_target(tutorial DEPENDS ${tutorial_targets})
  endif()
else()
  message(STATUS "Doxygen not found — doc and tutorial targets unavailable")
endif()
