# Doxyfile 1.9.8
# Doxygen configuration for the colman project.
# Generates HTML and PDF documentation from the sources and *.dox files.
# Usage: cmake --build bld --target doc
# (This file is a template; cmake generates the final Doxyfile in the
#  build directory via configure_file().)

#---------------------------------------------------------------------------
# Project metadata
#---------------------------------------------------------------------------

PROJECT_NAME           = "Colman"
PROJECT_NUMBER         = @PROJECT_VERSION@
PROJECT_BRIEF          = "Library and collection manager"
PROJECT_LOGO           = @CMAKE_CURRENT_SOURCE_DIR@/flutter/assets/icons/colman_logo.jpeg
OUTPUT_DIRECTORY       = @CMAKE_CURRENT_BINARY_DIR@/doc
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

#---------------------------------------------------------------------------
# Extraction
#---------------------------------------------------------------------------

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_ANON_NSPACES   = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
SHOW_FILES             = YES
SHOW_NAMESPACES        = YES
SHOW_INCLUDE_FILES     = YES
SORT_MEMBER_DOCS       = NO
SORT_BRIEF_DOCS        = NO

#---------------------------------------------------------------------------
# Warnings
#---------------------------------------------------------------------------

QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_LOGFILE           = @CMAKE_CURRENT_BINARY_DIR@/doc/doxygen_warnings.log

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------

INPUT                  = @CMAKE_CURRENT_SOURCE_DIR@/src \
                         @CMAKE_CURRENT_SOURCE_DIR@/tests \
                         @CMAKE_CURRENT_SOURCE_DIR@/doc
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.hpp \
                         *.cpp \
                         *.dox
RECURSIVE              = NO

# Exclude generated and irrelevant files
EXCLUDE_PATTERNS       = moc_*.cpp \
                         qrc_*.cpp \
                         ui_*.h \
                         colman_coding_style.* \
                         colman_test.*

EXAMPLE_PATH           =
IMAGE_PATH             = @CMAKE_CURRENT_SOURCE_DIR@/images \
                         @CMAKE_CURRENT_SOURCE_DIR@/flutter/assets/icons
HTML_EXTRA_FILES       = @CMAKE_CURRENT_SOURCE_DIR@/flutter/assets/icons/hint.jpeg \
                         @CMAKE_CURRENT_SOURCE_DIR@/flutter/assets/icons/warning.jpeg
LATEX_EXTRA_FILES      = @CMAKE_CURRENT_SOURCE_DIR@/flutter/assets/icons/hint.jpeg \
                         @CMAKE_CURRENT_SOURCE_DIR@/flutter/assets/icons/warning.jpeg

#---------------------------------------------------------------------------
# Source browsing
#---------------------------------------------------------------------------

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

#---------------------------------------------------------------------------
# HTML output
#---------------------------------------------------------------------------

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_COLORSTYLE        = LIGHT
HTML_DYNAMIC_SECTIONS  = YES
GENERATE_TREEVIEW      = YES
TREEVIEW_WIDTH         = 280
SEARCHENGINE           = YES
USE_MATHJAX            = NO
HTML_EXTRA_STYLESHEET  = @CMAKE_CURRENT_SOURCE_DIR@/doc/colman_doxy_extra.css

#---------------------------------------------------------------------------
# LaTeX / PDF output
#---------------------------------------------------------------------------

GENERATE_LATEX         = NO
LATEX_OUTPUT           = latex
LATEX_CMD_NAME         = pdflatex
MAKEINDEX_CMD_NAME     = makeindex
LATEX_MAKEINDEX_CMD    = makeindex
USE_PDFLATEX           = YES
COMPACT_LATEX          = NO
PAPER_TYPE             = a4
EXTRA_PACKAGES         =
LATEX_HEADER           =
LATEX_FOOTER           =
LATEX_EXTRA_STYLESHEET =
PDF_HYPERLINKS         = YES
LATEX_BATCHMODE        = NO
LATEX_HIDE_INDICES     = NO

#---------------------------------------------------------------------------
# Diagrams (Graphviz/Dot)
#---------------------------------------------------------------------------

HAVE_DOT               = YES
DOT_NUM_THREADS        = 0
DOT_PATH               = /usr/bin
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_GRAPH_MAX_NODES    = 80
MAX_DOT_GRAPH_DEPTH    = 4
GENERATE_LEGEND        = YES

#---------------------------------------------------------------------------
# Output formats (disabled)
#---------------------------------------------------------------------------

GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
GENERATE_DOCBOOK       = NO
GENERATE_AUTOGEN_DEF   = NO
GENERATE_PERLMOD       = NO

#---------------------------------------------------------------------------
# Preprocessor
#---------------------------------------------------------------------------

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES
PREDEFINED             =
SKIP_FUNCTION_MACROS   = YES

#---------------------------------------------------------------------------
# Aliases (matching Doxyfile_tutorial.in)
#---------------------------------------------------------------------------

ALIASES += tip=" \
\htmlonly<table style='border:none; background:#f9f9f9; padding:10px; width:100%;'><tr><td style='vertical-align:top;'><img src='hint.jpeg' style='width:32px;'/></td><td style='padding-left:10px;'><b>Tip:</b><br>\endhtmlonly \
\latexonly\noindent\begin{tabular}{@{}l@{\hspace{12pt}}p{\dimexpr\textwidth-36pt\relax}@{}}\raisebox{\dimexpr-\height+10pt\relax}{\includegraphics[height=24pt]{hint.jpeg}} & \textbf{Tip:}\newline\ignorespaces\endlatexonly"

ALIASES += endtip=" \
\htmlonly</td></tr></table>\endhtmlonly \
\latexonly\end{tabular}\vspace{10pt}\endlatexonly"

ALIASES += hint=" \
\htmlonly<table style='border:none; background:#f9f9f9; padding:10px; width:100%;'><tr><td style='vertical-align:top;'><img src='hint.jpeg' style='width:32px;'/></td><td style='padding-left:10px;'><b>Note:</b><br>\endhtmlonly \
\latexonly\noindent\begin{tabular}{@{}l@{\hspace{12pt}}p{\dimexpr\textwidth-36pt\relax}@{}}\raisebox{\dimexpr-\height+10pt\relax}{\includegraphics[height=24pt]{hint.jpeg}} & \textbf{Note:}\newline\ignorespaces\endlatexonly"

ALIASES += endhint=" \
\htmlonly</td></tr></table>\endhtmlonly \
\latexonly\end{tabular}\vspace{10pt}\endlatexonly"

ALIASES += warning=" \
\htmlonly<table style='border:none; background:#f9f9f9; padding:10px; width:100%;'><tr><td style='vertical-align:top;'><img src='warning.jpeg' style='width:32px;'/></td><td style='padding-left:10px;'><b>Warning:</b><br>\endhtmlonly \
\latexonly\noindent\begin{tabular}{@{}l@{\hspace{12pt}}p{\dimexpr\textwidth-36pt\relax}@{}}\raisebox{\dimexpr-\height+10pt\relax}{\includegraphics[height=24pt]{warning.jpeg}} & \textbf{Warning:}\newline\ignorespaces\endlatexonly"

ALIASES += endwarning=" \
\htmlonly</td></tr></table>\endhtmlonly \
\latexonly\end{tabular}\vspace{10pt}\endlatexonly"
